# Copy this file to `.env` and fill in the values.
#
# Every value below comes from the SAME place: the `google-services.json` you
# downloaded when you registered the Android app in Firebase.
# The one exception is AUTH_DOMAIN, which is not in that file (see below).
#
# .env is git-ignored. Never commit it.
#
# After editing, restart Metro so the values are inlined:
#   npx expo start --clear

# google-services.json -> client[0].api_key[0].current_key
# Also shown in console as "Web API Key" on the Project settings page.
EXPO_PUBLIC_FIREBASE_API_KEY=

# Not in google-services.json. It is your project id plus this suffix:
#   <EXPO_PUBLIC_FIREBASE_PROJECT_ID>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=

# google-services.json -> project_info.project_id
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# google-services.json -> project_info.storage_bucket
# (usually <project-id>.appspot.com, sometimes <project-id>.firebasestorage.app)
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# google-services.json -> project_info.project_number
# Yes, this is the 12-digit project number, despite the name.
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# google-services.json -> client[0].client_info.mobilesdk_app_id
# Looks like 1:123456789012:android:abcdef123456
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase console -> Authentication -> Sign-in method -> Google ->
# "Web SDK configuration" -> Web client ID.
# Only needed for the "Continue with Google" button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: your own server for photo analysis, coaching and recipe rewriting.
# Leave blank to keep those screens disabled rather than guessing.
EXPO_PUBLIC_API_BASE_URL=
